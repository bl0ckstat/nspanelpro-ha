# Copy to keystore.properties (gitignored) and fill in.
# Without it, assembleRelease still runs but produces an unsigned APK — useful
# for a build check, useless for installing on a panel.
#
# The keystore itself must live outside the repository. Losing it means no
# further updates can ever be installed over the fleet: Android will not
# replace an app with one signed by a different key, so every panel would need
# uninstalling by hand. Back it up somewhere durable.
storeFile=/path/to/nspanel-release.jks
storePassword=
keyAlias=nspanel
keyPassword=
